digraph G {
graph [rankdir=LR, bgcolor="transparent", pad="0.15", nodesep="0.13", ranksep="0.55", fontname="DejaVu Sans", fontsize=14];
node [fontname="DejaVu Sans", fontsize=11, color="#506481", penwidth=1, style=filled, fillcolor="#edf4fc"];
edge [color="#708096", penwidth=0.9, arrowhead=none];
Visitor [shape=box, style="rounded,filled", fillcolor="#ffffff", label="<<actor>>\nVisitor"];
Gateway [shape=box, style="rounded,filled", fillcolor="#ffffff", label="<<actor>>\nEmail gateway\n(live setup pending)"];
subgraph cluster_system {
label="Smart HMS: public access"; color="#617494"; style=rounded; margin=16;
Home [shape=ellipse, margin="0.13,0.07", label="View published hospital\ncontact details and hours"];
Directory [shape=ellipse, margin="0.13,0.07", label="Browse approved\ndoctors and services"];
Register [shape=ellipse, margin="0.13,0.07", label="Register a patient account"];
Login [shape=ellipse, margin="0.13,0.07", label="Sign in"];
Recover [shape=ellipse, margin="0.13,0.07", label="Recover password"];
Language [shape=ellipse, margin="0.13,0.07", label="Choose interface language"];
}
Visitor -> Home;
Visitor -> Directory;
Visitor -> Register;
Visitor -> Login;
Visitor -> Recover;
Visitor -> Language;
Gateway -> Recover;
}
