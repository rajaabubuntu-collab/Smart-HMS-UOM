NODE_ENV=development
PORT=4000
BIND_HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27018/smart_hms?replicaSet=rs0&directConnection=true
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SESSION_HOURS=8
# Avatar files stay on persistent server storage; production uses /data/avatars.
AVATAR_STORAGE_DIR=.local/avatars
# Enable only behind a trusted reverse proxy; see docs/security.md.
TRUST_PROXY=false

# Department guide: rules (offline), ollama (local AI), or groq (hosted AI).
# Groq setup and privacy controls: docs/groq-ai.md. Keep keys on the server only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=20000

# Local AI alternative; loopback endpoints and local models only.
# Pull this model first: ollama pull qwen3:4b-instruct-2507-q4_K_M
# Set to ollama to enable; rules keeps the original deterministic guide.
RECOMMENDATION_PROVIDER=rules
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_TIMEOUT_MS=45000
# Optional local thinking retry for unclear/invalid answers only (not safety referrals).
# Install this model first; leave unset to disable the second pass.
# OLLAMA_THINKING_MODEL=qwen3:4b
OLLAMA_THINKING_TIMEOUT_MS=120000

# Local previews never contact an external provider. Patients opt in under Email & SMS.
EMAIL_TRANSPORT=local
SMS_TRANSPORT=local
# Live providers: EMAIL_TRANSPORT=smtp and/or SMS_TRANSPORT=notifylk (or twilio).
# Configure secrets in the private .env; never put credentials in frontend variables.
ALLOW_LIVE_DELIVERY=false
# Comma-separated approved email addresses and +947XXXXXXXX numbers; no wildcard.
DELIVERY_ALLOWED_RECIPIENTS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Registered alphanumeric sender (Sri Lanka), or a Messaging Service containing that sender.
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Notify.lk: Settings > API Keys. Demo sender is case-sensitive; use your approved sender later.
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=NotifyDEMO

# Homepage AI help reuses GROQ_API_KEY/GROQ_MODEL when RECOMMENDATION_PROVIDER=groq.
# Per server process, UTC day. Set 0 to disable AI calls (help links still work).
PUBLIC_ASSISTANT_DAILY_LIMIT=100
