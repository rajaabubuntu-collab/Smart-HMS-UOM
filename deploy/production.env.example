# Copy to .env.production with mode 600; never commit real values.
APP_ORIGIN=https://hms.example.com
MONGODB_URI=mongodb+srv://APP_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER/smart_hms?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-new-random-secret-of-at-least-32-characters
SESSION_HOURS=8
# Enable only after provider setup and approved-recipient testing; see docs/connectivity.md.
EMAIL_TRANSPORT=local
SMS_TRANSPORT=local
ALLOW_LIVE_DELIVERY=false
DELIVERY_ALLOWED_RECIPIENTS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
